{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/discovery.schema.json",
  "title": "Discovery Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "discovery"
    },
    "agent_name": {
      "const": "DiscoveryAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "business_context", "constraints"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["goal_driven", "feedback_driven"]
        },
        "goal": {
          "type": ["string", "null"]
        },
        "feedback_summary": {
          "type": ["string", "null"]
        },
        "target_segment": {
          "type": ["string", "null"]
        },
        "time_horizon": {
          "type": ["string", "null"]
        },
        "business_context": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_links": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      },
      "oneOf": [
        {
          "required": ["goal"]
        },
        {
          "required": ["feedback_summary"]
        }
      ]
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_statement",
        "why_now",
        "problem_scope",
        "key_assumptions",
        "open_questions",
        "success_definition",
        "evidence_map"
      ],
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "why_now": {
          "type": "string",
          "minLength": 1
        },
        "problem_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["in_scope", "out_of_scope"],
          "properties": {
            "in_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "out_of_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "key_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_definition": {
          "type": "string",
          "minLength": 1
        },
        "evidence_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "source_id"],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "problem_clarity_score",
            "scope_precision",
            "assumption_quality_score",
            "evidence_to_claim_ratio",
            "root_cause_confidence",
            "open_question_count"
          ],
          "properties": {
            "problem_clarity_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "scope_precision": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "assumption_quality_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence_to_claim_ratio": {
              "type": "number",
              "minimum": 0
            },
            "root_cause_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "open_question_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
