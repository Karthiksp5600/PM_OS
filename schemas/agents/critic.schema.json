{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/critic.schema.json",
  "title": "Critic Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "critic"
    },
    "agent_name": {
      "const": "CriticAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_outputs", "constraints"],
      "properties": {
        "prior_outputs": {
          "type": "object",
          "additionalProperties": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critique_focus": {
          "type": "string"
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risks", "missing_assumptions", "contradictions", "unanswered_questions", "recommendations"],
      "properties": {
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "severity", "likelihood", "mitigation"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "likelihood": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              },
              "affected_stage": {
                "type": "string"
              }
            }
          }
        },
        "missing_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unanswered_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": ["gap_count", "contradiction_count", "risk_exposure_score", "critique_coverage", "uncertainty_count"],
          "properties": {
            "gap_count": {
              "type": "integer",
              "minimum": 0
            },
            "contradiction_count": {
              "type": "integer",
              "minimum": 0
            },
            "risk_exposure_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "critique_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "uncertainty_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
