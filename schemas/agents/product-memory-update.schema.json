{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/product-memory-update.schema.json",
  "title": "Product Memory Update Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "product_memory_update"
    },
    "agent_name": {
      "const": "ProductMemoryUpdateAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_edits", "approved_decisions", "approval_reference", "provenance"],
      "properties": {
        "approved_edits": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "approved_decisions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "approval_reference": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_entry_type", "memory_payload", "confidence", "version"],
      "properties": {
        "memory_entry_type": {
          "type": "string",
          "enum": ["writing_preference", "terminology_preference", "structural_preference", "decision_pattern", "organizational_decision"]
        },
        "memory_payload": {
          "type": "object",
          "additionalProperties": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "stored_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "memory_candidate_quality",
            "approval_rate",
            "provenance_completeness",
            "memory_utility_score",
            "memory_reuse_prediction"
          ],
          "properties": {
            "memory_candidate_quality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "approval_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "provenance_completeness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "memory_utility_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "memory_reuse_prediction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
