{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/prioritization.schema.json",
  "title": "Prioritization Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "prioritization"
    },
    "agent_name": {
      "const": "PrioritizationAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prd_output", "kpi_tree", "strategy_output", "scoring_framework"],
      "properties": {
        "prd_output": {
          "type": "object"
        },
        "kpi_tree": {
          "type": "object"
        },
        "strategy_output": {
          "type": "object"
        },
        "scoring_framework": {
          "type": "string",
          "enum": ["rice", "wsjf"]
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_used", "score_breakdown", "priority_rank", "assumption_sensitivity", "recommendation"],
      "properties": {
        "framework_used": {
          "type": "string",
          "enum": ["RICE", "WSJF"]
        },
        "score_breakdown": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "score", "weight"],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number"
              },
              "weight": {
                "type": "number"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "priority_rank": {
          "type": "integer",
          "minimum": 1
        },
        "assumption_sensitivity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assumption", "impact"],
            "properties": {
              "assumption": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              }
            }
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "score_completeness",
            "priority_confidence",
            "sensitivity_score",
            "ranking_clarity",
            "framework_consistency"
          ],
          "properties": {
            "score_completeness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "priority_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sensitivity_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ranking_clarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "framework_consistency": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
