{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/pm-review.schema.json",
  "title": "PM Review Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "pm_review"
    },
    "agent_name": {
      "const": "PMReviewAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_output", "experiment_output", "evidence_map"],
      "properties": {
        "decision_output": {
          "type": "object"
        },
        "experiment_output": {
          "type": "object"
        },
        "evidence_map": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "draft_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_bundle", "highlighted_changes", "approval_points", "open_items", "suggested_edits"],
      "properties": {
        "review_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "sections"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "content"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "highlighted_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_edits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "review_readiness",
            "editable_completeness",
            "comment_density",
            "human_correction_count",
            "review_turnaround_ms"
          ],
          "properties": {
            "review_readiness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "editable_completeness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "comment_density": {
              "type": "number",
              "minimum": 0
            },
            "human_correction_count": {
              "type": "integer",
              "minimum": 0
            },
            "review_turnaround_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
