{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/solutioning.schema.json",
  "title": "Solutioning Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "solutioning"
    },
    "agent_name": {
      "const": "SolutioningAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_statement", "constraints"],
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "kpi_tree_summary": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strategic_context": {
          "type": "string"
        },
        "solution_boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solution_options", "option_summary", "trade_offs", "dependencies", "expected_impact"],
      "properties": {
        "solution_options": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "how_it_works",
              "benefits",
              "tradeoffs",
              "dependencies",
              "risks",
              "estimated_effort",
              "evidence_map"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "how_it_works": {
                "type": "string",
                "minLength": 1
              },
              "benefits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tradeoffs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "estimated_effort": {
                "type": "string"
              },
              "evidence_map": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["claim", "source_id"],
                  "properties": {
                    "claim": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "option_summary": {
          "type": "string"
        },
        "trade_offs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_impact": {
          "type": "string"
        },
        "implementation_notes": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "option_count",
            "option_diversity_score",
            "constraint_coverage",
            "evidence_linkage_score",
            "feasibility_score"
          ],
          "properties": {
            "option_count": {
              "type": "integer",
              "minimum": 0
            },
            "option_diversity_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "constraint_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence_linkage_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "feasibility_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
