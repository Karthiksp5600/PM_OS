{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/kpi-tree.schema.json",
  "title": "KPI Tree Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "kpi_tree"
    },
    "agent_name": {
      "const": "KpiTreeAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_statement", "business_goal", "constraints"],
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "business_goal": {
          "type": "string",
          "minLength": 1
        },
        "product_area": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metric_context": {
          "type": "string"
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "north_star_metric",
        "input_metrics",
        "guardrail_metrics",
        "metric_definitions",
        "metric_dependencies",
        "measurement_gaps",
        "kpi_tree"
      ],
      "properties": {
        "north_star_metric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "definition", "formula", "target_direction"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "definition": {
              "type": "string",
              "minLength": 1
            },
            "formula": {
              "type": "string",
              "minLength": 1
            },
            "target_direction": {
              "type": "string",
              "enum": ["increase", "decrease", "maintain"]
            }
          }
        },
        "input_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric_definition"
          }
        },
        "guardrail_metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric_definition"
          }
        },
        "metric_definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric_definition"
          }
        },
        "metric_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measurement_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kpi_tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_metric", "child_metrics"],
          "properties": {
            "root_metric": {
              "$ref": "#/$defs/metric_definition"
            },
            "child_metrics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/metric_definition"
              }
            },
            "guardrail_metrics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/metric_definition"
              }
            }
          }
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "kpi_completeness",
            "measurability_score",
            "guardrail_coverage",
            "north_star_alignment",
            "metric_dependency_clarity",
            "metric_completeness"
          ],
          "properties": {
            "kpi_completeness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "measurability_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "guardrail_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "north_star_alignment": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "metric_dependency_clarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "metric_completeness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "metric_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "definition"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": ["increase", "decrease", "maintain"]
        },
        "owner": {
          "type": "string"
        },
        "instrumentation": {
          "type": "string"
        }
      }
    }
  }
}
