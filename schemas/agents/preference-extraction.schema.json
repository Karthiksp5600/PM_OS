{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/preference-extraction.schema.json",
  "title": "Preference Extraction Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "preference_extraction"
    },
    "agent_name": {
      "const": "PreferenceExtractionAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_edits", "review_history", "document_diff"],
      "properties": {
        "approved_edits": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "review_history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "document_diff": {
          "type": "string"
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writing_preferences",
        "terminology_preferences",
        "structural_preferences",
        "decision_patterns",
        "confidence"
      ],
      "properties": {
        "writing_preferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terminology_preferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "structural_preferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "preference_confidence",
            "signal_to_noise_ratio",
            "approved_edit_coverage",
            "preference_stability",
            "learning_utility_score"
          ],
          "properties": {
            "preference_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "signal_to_noise_ratio": {
              "type": "number",
              "minimum": 0
            },
            "approved_edit_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "preference_stability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "learning_utility_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
