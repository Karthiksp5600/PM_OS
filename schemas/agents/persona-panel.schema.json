{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/persona-panel.schema.json",
  "title": "Persona Panel Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "persona_panel"
    },
    "agent_name": {
      "const": "PersonaPanelAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solution_options", "stakeholder_personas"],
      "properties": {
        "solution_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "stakeholder_personas": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "goals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "concerns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "decision_summary": {
          "type": "string"
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona_feedback", "persona_objections", "persona_adoption_risk", "persona_support_level"],
      "properties": {
        "persona_feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["persona_name", "stance", "support_level", "concerns"],
            "properties": {
              "persona_name": {
                "type": "string",
                "minLength": 1
              },
              "stance": {
                "type": "string",
                "enum": ["support", "neutral", "oppose", "mixed"]
              },
              "support_level": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "concerns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "recommendations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "persona_objections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persona_adoption_risk": {
          "type": "string"
        },
        "persona_support_level": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "persona_coverage",
            "objection_count",
            "adoption_risk_score",
            "persona_disagreement_score",
            "support_level_score"
          ],
          "properties": {
            "persona_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "objection_count": {
              "type": "integer",
              "minimum": 0
            },
            "adoption_risk_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "persona_disagreement_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "support_level_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
