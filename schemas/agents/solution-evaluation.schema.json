{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/solution-evaluation.schema.json",
  "title": "Solution Evaluation Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "solution_evaluation"
    },
    "agent_name": {
      "const": "SolutionEvaluationAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solution_options", "decision_criteria"],
      "properties": {
        "solution_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "decision_criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": ["impact_weight", "effort_weight", "risk_weight"],
          "properties": {
            "impact_weight": {
              "type": "number"
            },
            "effort_weight": {
              "type": "number"
            },
            "risk_weight": {
              "type": "number"
            },
            "confidence_weight": {
              "type": "number"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scores", "ranked_options", "scoring_rationale", "sensitivity_notes", "recommendation_summary"],
      "properties": {
        "scores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option_name", "impact_score", "effort_score", "risk_score", "confidence_score", "weighted_score"],
            "properties": {
              "option_name": {
                "type": "string",
                "minLength": 1
              },
              "impact_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "effort_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "risk_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "weighted_score": {
                "type": "number"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "ranked_options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rank", "option_name", "weighted_score"],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "option_name": {
                "type": "string",
                "minLength": 1
              },
              "weighted_score": {
                "type": "number"
              }
            }
          }
        },
        "scoring_rationale": {
          "type": "string"
        },
        "sensitivity_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendation_summary": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "impact_score",
            "effort_score",
            "risk_score",
            "weighted_score",
            "sensitivity_score",
            "decision_confidence"
          ],
          "properties": {
            "impact_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "effort_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "risk_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "weighted_score": {
              "type": "number"
            },
            "sensitivity_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "decision_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
