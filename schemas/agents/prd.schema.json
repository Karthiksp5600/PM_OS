{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/agents/prd.schema.json",
  "title": "PRD Agent Contract",
  "allOf": [
    {
      "$ref": "../shared/stage-contract.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": ["stage_id", "agent_name", "input", "structured_output", "metrics"],
  "properties": {
    "stage_id": {
      "const": "prd"
    },
    "agent_name": {
      "const": "PRDAgent"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_output", "experiment_output", "approved_edits"],
      "properties": {
        "decision_output": {
          "type": "object"
        },
        "experiment_output": {
          "type": "object"
        },
        "approved_edits": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "company_context_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_statement",
        "goals",
        "non_goals",
        "scope",
        "requirements",
        "metrics",
        "risks",
        "open_questions",
        "appendix"
      ],
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["in_scope", "out_of_scope"],
          "properties": {
            "in_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "out_of_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "priority"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": ["must", "should", "could", "won't"]
              },
              "acceptance_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "definition"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": ["string", "number"]
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "appendix": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "allOf": [
        {
          "$ref": "../shared/metrics-base.schema.json"
        },
        {
          "type": "object",
          "required": [
            "prd_completeness",
            "requirement_clarity",
            "scope_clarity",
            "dependency_clarity",
            "traceability_score",
            "readability_score"
          ],
          "properties": {
            "prd_completeness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "requirement_clarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "scope_clarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "dependency_clarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "traceability_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "readability_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
