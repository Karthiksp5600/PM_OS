{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/shared/citation.schema.json",
  "title": "ProductPilot Citation",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "claim", "confidence"],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": ["company_context", "rag", "okf", "memory", "feedback", "note", "external"]
    },
    "source_title": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri-reference"
    },
    "excerpt": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trust_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "freshness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
