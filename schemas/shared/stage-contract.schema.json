{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productpilot.ai/schemas/shared/stage-contract.schema.json",
  "title": "ProductPilot Stage Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "tenant_id",
    "project_id",
    "stage_id",
    "agent_name",
    "entry_mode",
    "user_intent",
    "context",
    "instructions",
    "budgets",
    "policy",
    "status",
    "timestamp",
    "input",
    "structured_output",
    "citations",
    "assumptions",
    "open_questions",
    "warnings",
    "errors",
    "metrics",
    "evaluation",
    "next_action",
    "artifact_ref",
    "version"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "entry_mode": {
      "type": "string",
      "enum": ["goal_driven", "feedback_driven"]
    },
    "user_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "feedback_summary"],
      "properties": {
        "goal": {
          "type": ["string", "null"]
        },
        "feedback_summary": {
          "type": ["string", "null"]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_context_refs", "prior_stage_refs", "retrieval_refs", "memory_refs"],
      "properties": {
        "company_context_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prior_stage_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retrieval_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "memory_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_notes": {
          "type": "string"
        }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "constraints", "success_criteria", "output_style"],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_style": {
          "type": "string"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_budget", "latency_budget_ms", "retry_count"],
      "properties": {
        "token_budget": {
          "type": "integer",
          "minimum": 0
        },
        "latency_budget_ms": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "cost_budget_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_required", "can_write_memory", "can_publish"],
      "properties": {
        "approval_required": {
          "type": "boolean"
        },
        "can_write_memory": {
          "type": "boolean"
        },
        "can_publish": {
          "type": "boolean"
        },
        "sensitivity": {
          "type": "string",
          "enum": ["normal", "internal", "confidential"]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "blocked", "failed"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "input": {
      "type": "object"
    },
    "structured_output": {
      "type": "object"
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "./citation.schema.json"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    },
    "evaluation": {
      "$ref": "./evaluation.schema.json"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  }
}
